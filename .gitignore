# ==========================================================================
# STM32CubeIDE (Eclipse) Metadata & Toolchain Build Outputs
# ==========================================================================

# Eclipse / CubeIDE internal configuration and indexing files
.metadata/
.recommenders/
remote_connections.xml

# Log files generated by the IDE or debugger
*.log

# Local debugger configurations (stores window layouts, breakpoints, etc.)
*.launch

# ==========================================================================
# Build Directories & Compilation Artifacts (GCC/Make)
# ==========================================================================

# Exclude whole Debug and Release build output folders
# (These folders contain intermediate .o, .d, and compiler log files)
Debug/
Release/

# Individual compiler outputs just in case they bypass directories
*.o
*.su
*.d

# NOTE: We intentionally ignore the output binaries inside Debug/ via the rule above.
# BUT we want to keep your final production files (.hex) visible in the repo root
# if you decide to copy them there manually for the reviewer.

# ==========================================================================
# STM32CubeMX Configuration
# ==========================================================================

# Temporary or backup files from the graphical configuration tool
~*.tmp
*.bak

# IMPORTANT: Do NOT ignore the *.ioc file and the boot/linker scripts.
# The repository MUST contain the .ioc file, .project, .cproject, and STM32F103C8TX_FLASH.ld
# so other developers (and reviewers) can instantly import and build your project.

# ==========================================================================
# OS & System Trash
# ==========================================================================
.DS_Store
Thumbs.db
